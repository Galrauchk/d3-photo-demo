---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Extension & Agrandissement Maison",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Atelier Roc",
    "telephone": "+33612345678",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Montpellier",
      "addressRegion": "Hérault",
      "addressCountry": "FR"
    }
  },
  "areaServed": "Hérault",
  "url": "https://d3-photo-demo.netlify.app/services/extension"
};
---

<Layout
  title="Extension Maison Montpellier Hérault — Atelier Roc"
  description="Extension et agrandissement de maison à Montpellier et dans l'Hérault. Atelier Roc réalise vos extensions en bois, béton ou verre avec permis de construire inclus dans le suivi."
  image="https://images.unsplash.com/photo-1600566752355-35792bedcfea?w=1200&q=80"
  schema={schema}
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="hero-bg" style="background-image:url('https://images.unsplash.com/photo-1600566752355-35792bedcfea?w=1920&q=90')"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content fade-up">
      <nav class="breadcrumb">
        <a href="/">Accueil</a>
        <span>›</span>
        <a href="/services/renovation-complete">Services</a>
        <span>›</span>
        <span>Extension & agrandissement</span>
      </nav>
      <h1>Extension & agrandissement</h1>
      <p>Gagner de l'espace sans déménager — une nouvelle pièce, une nouvelle vie.</p>
    </div>
  </section>

  <!-- SPLIT — Description principale -->
  <section class="split-section">
    <div class="split-image clip-reveal">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1200&q=85"
        alt="Extension contemporaine en ossature bois avec grande baie vitrée — Atelier Roc Hérault"
        loading="lazy"
      />
    </div>
    <div class="split-text fade-up">
      <span class="label">Extension & agrandissement</span>
      <h2>Agrandir votre maison sans la quitter</h2>
      <p>Manque de place pour un bureau, une chambre supplémentaire ou une grande cuisine ouverte ? L'extension est souvent la solution la plus économique et la plus rapide. Atelier Roc maîtrise les trois grandes typologies : l'extension en ossature bois (rapide, écologique), l'extension en béton banché (robuste, thermique) et la véranda en aluminium et verre (lumineuse, contemporaine).</p>
      <p>Nous accompagnons également les démarches administratives — déclaration préalable ou permis de construire — pour un suivi clé en main.</p>
      <a href="/devis" class="btn-primary">Demander un devis gratuit</a>
    </div>
  </section>

  <!-- SPLIT reverse — Déroulé du projet -->
  <section class="split-section reverse">
    <div class="split-image clip-reveal">
      <img
        src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=1200&q=85"
        alt="Plans d'architecture pour extension maison Montpellier — Atelier Roc"
        loading="lazy"
      />
    </div>
    <div class="split-text fade-up">
      <span class="label">De l'esquisse au chantier</span>
      <h2>Un projet bien préparé est à moitié réalisé</h2>
      <p>Notre architecte d'intérieur réalise l'étude de faisabilité, les plans d'exécution et le dossier de permis. Nous consultons notre réseau d'ingénieurs structures pour les projets qui nécessitent un calcul de charge. Chaque extension est pensée pour s'intégrer harmonieusement à l'existant — matériaux, pente de toiture, enduit — sans paraître un ajout tardif.</p>
      <p>Délai moyen de réalisation : 8 à 16 semaines selon la surface et la technique choisie.</p>
      <a href="/notre-philosophie" class="btn-outline">Notre philosophie</a>
    </div>
  </section>

  <!-- PARALLAX -->
  <section class="parallax-section">
    <div class="parallax-bg" style="background-image:url('https://images.unsplash.com/photo-1600566752355-35792bedcfea?w=1920&q=85')"></div>
    <div class="parallax-overlay"></div>
    <div class="parallax-content fade-up">
      <span class="label" style="color:var(--cyan);display:block;margin-bottom:1rem;">Atelier Roc</span>
      <h2>« Votre maison a encore des histoires à vous raconter — donnez-lui de l'espace. »</h2>
      <p>Extensions maison à Montpellier, Béziers, Sète et dans tout l'Hérault.</p>
    </div>
  </section>

  <!-- STATS -->
  <div class="stats-band">
    <div class="stat-item fade-up"><div class="number">80+</div><div class="stat-label">Extensions réalisées</div></div>
    <div class="stat-item fade-up"><div class="number">15 m²</div><div class="stat-label">Surface minimale</div></div>
    <div class="stat-item fade-up"><div class="number">8–16</div><div class="stat-label">Semaines de travaux</div></div>
    <div class="stat-item fade-up"><div class="number">3</div><div class="stat-label">Techniques maîtrisées</div></div>
  </div>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-bg" style="background-image:url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1920&q=85')"></div>
    <div class="cta-overlay"></div>
    <div class="cta-content fade-up">
      <h2>Votre maison mérite plus d'espace</h2>
      <p>Étude de faisabilité gratuite. Nous intervenons dans tout l'Hérault.</p>
      <div class="btn-group">
        <a href="/devis" class="btn-primary">Demander un devis</a>
        <a href="/contact" class="btn-outline">Nous contacter</a>
      </div>
    </div>
  </section>

</Layout>
